<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DevangelicPlayer.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="OledBlack">#000000</Color>
            <Color x:Key="Card">#0A0A0A</Color>
            <Color x:Key="Card2">#111111</Color>
            <Color x:Key="Accent">#1DB954</Color>
            <Color x:Key="TextWhite">#FFFFFF</Color>
            <Color x:Key="TextGray">#A1A1A1</Color>
            <Color x:Key="TextDim">#6B6B6B</Color>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextWhite}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>

            <Style x:Key="CardFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource Card}" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="BorderColor" Value="#1A1A1A" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="Padding" Value="14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
