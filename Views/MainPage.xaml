<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DevangelicPlayer.Views.MainPage"
             Title="DevangelicPlayer" BackgroundColor="#121212">
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Padding="12">
        <SearchBar Grid.Row="0" Placeholder="Buscar artista, album, titulo..." Text="{Binding SearchText}" SearchCommand="{Binding SearchCommand}" TextColor="White" PlaceholderColor="#888" BackgroundColor="#1E1E1E"/>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Songs}" SelectionMode="Single" SelectedItem="{Binding SelectedSong}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="50,*,Auto" Padding="10,8" BackgroundColor="#1A1A1A">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PlayCommand}" CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="{Binding Track}" TextColor="#888" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{Binding Title}" TextColor="White" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                            <Label Text="{Binding Artist}" TextColor="#AAA" FontSize="12"/>
                            <Label Text="{Binding Album}" TextColor="#666" FontSize="11"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="{Binding Duration}" TextColor="#888" VerticalOptions="Center"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" BackgroundColor="#1E1E1E" Padding="12">
            <VerticalStackLayout>
                <Label Text="{Binding SelectedSong.Title}" TextColor="White" FontAttributes="Bold"/>
                <Label Text="{Binding SelectedSong.Artist}" TextColor="#AAA" FontSize="12"/>
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Play/Pausa" Command="{Binding TogglePlayCommand}" BackgroundColor="#FF6B00" TextColor="White" CornerRadius="25" WidthRequest="100" HeightRequest="50"/>
        </Grid>
        <HorizontalStackLayout Grid.Row="3" Spacing="10" Margin="0,10,0,0">
            <Button Text="Escanear" Command="{Binding ScanCommand}" BackgroundColor="#2A2A2A" TextColor="White" HorizontalOptions="FillAndExpand"/>
            <Button Text="Actualizar" Command="{Binding LoadCommand}" BackgroundColor="#2A2A2A" TextColor="White" HorizontalOptions="FillAndExpand"/>
            <Button Text="Organizar" Command="{Binding OrganizeCommand}" BackgroundColor="#FF6B00" TextColor="White" HorizontalOptions="FillAndExpand"/>
        </HorizontalStackLayout>
        <Label Grid.Row="4" Text="{Binding Status}" TextColor="#888" FontSize="11" HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
